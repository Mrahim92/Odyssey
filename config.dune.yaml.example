# Copy to config.dune.yaml for the Aug 18 Dune: Part Three on-sale.
# Usage: python -m odyssey_bot run --config config.dune.yaml

movie:
  title_match: [dune]
  # Exact labels in AMC's movie/format dropdowns (verify on amctheatres.com before Aug 18).
  amc_movie_name: "Dune: Part Three"
  amc_format_name: "IMAX 70MM"
  alert_label: "Dune Part Three IMAX 70mm"
  format_match: [imax 70mm, imax 70 mm, 70mm imax]

monitor:
  # Opening weekend + first week of December release.
  start_date: "2026-12-18"
  end_date: "2026-12-28"
  # Switch to fast polling at noon ET on Aug 18.
  onsale_at: "2026-08-18T12:00:00-04:00"
  poll_interval_seconds: 120
  onsale_poll_interval_seconds: 20
  poll_interval_fast_seconds: 15
  concurrency: 1
  headless: true
  page_timeout_seconds: 45
  seat_check_delay_seconds: 1.0
  seat_cache_ttl_minutes: 5

booking:
  min_seats: 4
  preferred_rows: [H, J, K, L, M]
  theater_ids: [amc-lincoln-square]
  auto_open: true
  auto_book: false
  stop_before_payment: true

notifications:
  console: true
  desktop: true
  discord_webhook: ""
  sound: true

browser:
  state_dir: browser_state
