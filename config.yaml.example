# Copy to config.yaml and customize.

movie:
  # Title fragments used to match showtimes (case-insensitive).
  title_match:
    - odyssey
  # Format strings that must appear near the showtime (case-insensitive).
  # Rejects plain IMAX Laser / digital IMAX without 70mm film.
  format_match:
    - imax 70mm
    - imax 70 mm
    - 70mm imax
    - 15/70

monitor:
  # How many days ahead to scan when end_date is not set.
  days_ahead: 21
  # Scan through this date inclusive (overrides days_ahead when set).
  end_date: "2026-09-30"
  # Seconds between full scans across all theaters.
  poll_interval_seconds: 180
  # Faster polling when a scan finds availability (seconds).
  poll_interval_fast_seconds: 30
  # Max concurrent browser tabs per scan.
  concurrency: 3
  # Headless browser (set false to watch the bot work).
  headless: true
  # Timeout per theater page load (seconds).
  page_timeout_seconds: 45

booking:
  # Minimum contiguous seats required to trigger an alert.
  min_seats: 4
  # Only count available seats in these rows (empty list = any row).
  preferred_rows:
    - H
    - J
    - K
    - L
    - M
  # AMC Lincoln Square 13 & IMAX — NYC only.
  theater_ids:
    - amc-lincoln-square
  # Preferred showtime window (24h local). Empty strings = any time.
  earliest_time: ""
  latest_time: ""
  # auto_open: open purchase URL in your default browser when seats found.
  auto_open: true
  # auto_book: attempt Playwright seat selection (requires saved login).
  auto_book: false
  # Stop before payment even when auto_book is true (recommended).
  stop_before_payment: true

notifications:
  console: true
  desktop: true
  # Discord webhook URL (optional). Create in Server Settings → Integrations.
  discord_webhook: ""
  # Beep on Windows when tickets found.
  sound: true

browser:
  # Saved login sessions per chain (created via `python -m odyssey_bot login amc`).
  state_dir: browser_state
